{
  "name": "priorisation-epic-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/write-config.mjs --dev && ng serve",
    "build": "node scripts/write-config.mjs && ng build && node scripts/inject-csp.mjs",
    "build:e2e": "node scripts/write-config.mjs --dev && ng build --configuration development && node scripts/inject-csp.mjs --dev",
    "test": "ng test --watch=false --coverage && node --test \"scripts/*.test.mjs\"",
    "lint": "ng lint",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:journeys": "playwright test --config playwright.journeys.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
