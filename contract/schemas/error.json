{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.json",
  "title": "error (server → client)",
  "description": "A forbidden or invalid intent changed nothing. The text shown comes from the front. SESSION_CLOSED: the session is closed (read-only), only changeStatus REOPEN is accepted. SESSION_NOT_STARTED: changeStatus CLOSE on a session still in PREPARATION. STALE_VERSION: the intent carried an outdated feature version (no silent overwrite, constitution III). SCALE_IMPACT carries impactedValues.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "code"],
  "properties": {
    "type": {
      "const": "error"
    },
    "code": {
      "type": "string",
      "enum": [
        "INVALID_MESSAGE",
        "FORBIDDEN",
        "SESSION_CLOSED",
        "STALE_VERSION",
        "INVALID_VALUE",
        "DUPLICATE_EXTERNAL_ID",
        "FEATURE_IN_OPEN_ROUND",
        "ROUND_REVEALED",
        "SCALE_IMPACT",
        "UNKNOWN_PARTICIPANT",
        "SESSION_NOT_STARTED",
        "ROUND_OPEN",
        "PARTICIPANT_OFFLINE",
        "UNKNOWN_CRITERION",
        "SESSION_NAME_TAKEN"
      ]
    },
    "featureId": {
      "type": "string",
      "format": "uuid"
    },
    "impactedValues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["externalId", "criterion", "value"],
        "properties": {
          "externalId": {
            "type": "string"
          },
          "criterion": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]{0,19}$"
          },
          "value": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
