{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delete-feature.json",
  "title": "deleteFeature (client → server)",
  "description": "Facilitator only. Soft delete, so the history is kept.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "featureId", "version"],
  "properties": {
    "type": {
      "const": "deleteFeature"
    },
    "featureId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    }
  }
}
