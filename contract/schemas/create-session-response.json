{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "create-session-response.json",
  "title": "Create session response",
  "description": "201 of POST /api/sessions. The front builds the private link `/s/{sessionId}/animer#{animationToken}`; the server only keeps the hashes of the tokens.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "participantToken", "animationToken"],
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "participantToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "animationToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
