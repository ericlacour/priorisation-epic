{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "create-session-response.json",
  "title": "createSession response",
  "description": "The creator becomes facilitator (FR-001, FR-002). The front builds the private link /s/{sessionId}/animer#{animationToken}; the server keeps only the hashes of the tokens.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "participantToken", "animationToken"],
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "participantToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "animationToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
